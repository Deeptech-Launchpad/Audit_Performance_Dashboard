{
  "name": "audit-performance-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.24.0",
    "esbuild": "npm:esbuild-wasm@^0.21.5"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0"
  }
}
